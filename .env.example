# Copy to .env.local for local use. Never commit real secrets.

# Polymarket credentials. Scanner mode does not require these.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# Kalshi credentials for future authenticated adapters.
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Additional live-mode acknowledgement. Live execution is still disabled in code.
POLYMARKET_ARB_LIVE_CONFIRMATION=
